PRODUCTION_BIND_ADDRESS=127.0.0.1
PRODUCTION_HTTPS_PORT=8443
PRODUCTION_DB_NAME=ambs_production
PRODUCTION_DB_OWNER=ambs_migration_owner
PRODUCTION_DB_RUNTIME_USER=ambs_runtime
PRODUCTION_ALLOWED_ORIGINS='["https://erp.example.invalid:8443"]'
PRODUCTION_DB_OWNER_PASSWORD_FILE=/absolute/private/database-owner-password
