# Copy to .env and choose a unique local password before first startup.
POSTGRES_DB=ambs_erp
POSTGRES_USER=ambs_dev
POSTGRES_PASSWORD=replace_with_a_random_local_password
APP_ENV=development
LOG_LEVEL=INFO
# JSON list of exact browser origins. Production requires HTTPS origins.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
AUTH_COOKIE_SECURE=false
# Generate a private random value of at least 32 characters.
AUTH_BFF_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_IDENTITY_LIMIT=5
LOGIN_IDENTITY_WINDOW_SECONDS=300
LOGIN_SOURCE_LIMIT=60
LOGIN_SOURCE_WINDOW_SECONDS=60
# Backend-only secret: set locally in ignored .env. Never use NEXT_PUBLIC.
ORS_API_KEY=
ROUTING_PROVIDER=ors
ROUTING_TIMEOUT_SECONDS=8
# Local safety budgets; verify your actual HeiGIT account quotas.
ROUTING_REQUESTS_PER_MINUTE=30
ROUTING_REQUESTS_PER_DAY=1000
# Optional: configure only after company approval; leave both blank otherwise.
TRANSPORT_RATE_PER_KM=
TRANSPORT_FIXED_RATE=
TRANSPORT_CURRENCY=AED
