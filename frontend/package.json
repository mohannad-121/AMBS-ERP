  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
